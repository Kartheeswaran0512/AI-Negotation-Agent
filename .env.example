# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit a real .env file.
# Every value here is a placeholder.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Store ----------------------------------------------------------------
# STORE=mysql uses the database below. STORE=memory needs no database at all,
# and everything is lost when the process stops - fine for trying the demo.
# Unset: memory when DB_PASSWORD is empty, mysql otherwise. In production it
# must be set explicitly if DB_PASSWORD is empty.
# A memory store lives inside one process: use `npm start` or
# `node src/index.js both`, not a separate `npm run worker`.
STORE=

# --- Database -------------------------------------------------------------
# These match docker/docker-compose.yml. Change them for a local MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=negotiation
DB_PASSWORD=replace-with-your-own-password
DB_NAME=negotiation_agent
DB_CONNECTION_LIMIT=10

# Only used by docker-compose to initialise the MySQL container.
DB_ROOT_PASSWORD=replace-with-another-password

# --- API auth -------------------------------------------------------------
# Any non-empty string. Callers send it as the `x-api-key` header.
API_KEY=replace-with-a-long-random-string

# --- LLM ------------------------------------------------------------------
# LLM_PROVIDER:
#   auto   - use Claude when ANTHROPIC_API_KEY is set, otherwise the rules engine
#   claude - require Claude (fails fast when the key is missing)
#   rules  - never call an LLM; use the deterministic rules engine only
#   off    - no interpretation at all; the agent uses structured input only
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
LLM_TIMEOUT_MS=8000
LLM_MAX_TOKENS=8192

# --- Agent safety switches ------------------------------------------------
# AGENT_ENABLED=false stops the worker from acting at all.
# AGENT_DRY_RUN=true makes the agent decide and record, but send nothing.
AGENT_ENABLED=true
AGENT_DRY_RUN=false
AGENT_TICK_MS=5000
AGENT_MAX_ROUNDS=6
AGENT_DAILY_SEND_LIMIT=200

# --- Integration tests ----------------------------------------------------
# Set to 1 to run the MySQL-backed repository contract tests. They create and
# drop tables, so point them at a throwaway database only.
RUN_DB_TESTS=0
TEST_DB_NAME=negotiation_agent_test

# --- Payments (PayPal) ----------------------------------------------------
# Leave both credentials empty to turn payments off: accepting a deal then just
# records the acceptance. Set both to have accept open a PayPal order.
# Get sandbox credentials from developer.paypal.com -> Apps & Credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Where PayPal sends the buyer back. Default to this server on PORT.
PAYPAL_RETURN_URL=http://localhost:3000/paid
PAYPAL_CANCEL_URL=http://localhost:3000/cancelled
# INR deals are charged in USD at this fixed DEMO rate. Not a market rate.
DEMO_INR_PER_USD=85
# true: create orders and invoices through @paypal/agent-toolkit (called only
# after the buyer accepts, never by the agent), falling back to REST on failure.
PAYPAL_USE_TOOLKIT=false
# Invoices need the "Invoicing" feature enabled on your PayPal app; without it
# PayPal answers 403 NOT_AUTHORIZED and payments still work, uninvoiced.

# --- Demo button ----------------------------------------------------------
# The home page's "Run demo" button and its /demo routes, which take no API
# key. Unset means on, except when NODE_ENV=production. Each run creates a
# buyer, three suppliers and their negotiations in the database, and the
# agent's messages count towards AGENT_DAILY_SEND_LIMIT.
DEMO_ENABLED=

